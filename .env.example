# ==============================================================================
# koh! Enterprise Command Center — Server Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your real keys.
# ==============================================================================

# Application Execution Mode: 'development' | 'production' | 'test'
# - development: auto-seeds fresh database once, enables verbose API logging
# - production: strictly queries & persists to MongoDB; zero dummy/mock data
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Database Connection
# Local Development: mongodb://127.0.0.1:27017/koh_command_center
# Production Example: mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/koh_command_center?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/koh_command_center

# Anthropic Claude API for Influencer Script Generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Shopify D2C Store Integration (Track Sales by Coupon Code & Compute Collab ROI)
# Enter your store domain (e.g. kohfoods.myshopify.com) and Admin API access token (starts with shpat_)
SHOPIFY_STORE_DOMAIN=https://your-store.myshopify.com/
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_api_token_here
SHOPIFY_API_VERSION=2024-01

# CORS Allowed Origins
# Development: * (or http://localhost:3000,http://localhost:3001)
# Production: https://command.kohfoods.com,https://floor.kohfoods.com
CORS_ORIGIN=*

# ==============================================================================
# Cross-Platform Social Publishing Integrations (YouTube, Meta, LinkedIn)
# ==============================================================================

# 1. YouTube Data API v3 (Google Cloud Console)
# Console: https://console.cloud.google.com/
# Scope: https://www.googleapis.com/auth/youtube.upload, https://www.googleapis.com/auth/youtube
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# 2. Meta Graph API (Instagram Business & Facebook Page)
# Console: https://developers.facebook.com/
# Required Scopes: pages_manage_posts, pages_read_engagement, instagram_basic, instagram_content_publish
META_APP_ID=your_meta_app_id
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# 3. LinkedIn Marketing Developer Platform
# Console: https://www.linkedin.com/developers/
# Required Scopes: w_member_social, w_organization_social, r_organization_social
# Format: urn:li:organization:12345678 or urn:li:person:...
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_ORGANIZATION_URN=urn:li:organization:12345678

# ==============================================================================
# Paid Ads Management & Scheduling Integrations (Meta Ads & Google Ads)
# ==============================================================================

# 1. Meta Marketing API (Facebook & Instagram Ads Manager)
# Console: https://developers.facebook.com/apps/
# Scopes: ads_management, ads_read, business_management
# Format for ad account: act_1234567890
META_ADS_ACCESS_TOKEN=your_meta_ads_access_token
META_AD_ACCOUNT_ID=act_1234567890
META_PIXEL_ID=your_meta_pixel_id

# 2. Google Ads API & Google Cloud Console
# Console: https://console.cloud.google.com/ & Google Ads Manager (MCC)
# Scope: https://www.googleapis.com/auth/adwords
# Format for customer id: 10-digit number without hyphens (e.g. 1234567890)
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_PROJECT_NUMBER=your_project_number
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_CLIENT_ID=your_google_ads_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_google_ads_refresh_token
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
